APP_NAME="WiGO Back Office"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Temps réel. `log` par défaut : un clone frais démarre sans serveur Reverb,
# et les écrans retombent sur leur `wire:poll`. Passer à `reverb` une fois les
# identifiants ci-dessous renseignés et `php artisan reverb:start` lancé.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Redis : la diffusion temps réel passe par la file, et le pilote `database`
# ajoute une seconde et demie de latence à chaque message. Un worker est donc
# nécessaire — sans lui les messages sont bien enregistrés, mais le temps réel
# ne part pas et seul le `wire:poll` les fait apparaître.
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Reverb (serveur de websockets auto-hébergé). Les VITE_* sont lues par le
# client : sans clé, aucun client Echo n'est construit.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- WiGO PRO ---
WIGO_TERMS_VERSION=1.0

# Renvoie le code OTP en clair dans la réponse de /auth/otp/request.
# Contournement complet de l'OTP : à n'activer qu'en local.
# Ignoré de toute façon lorsque APP_ENV=production.
WIGO_OTP_EXPOSE_CODE=false

# Documentation de l'API générée (/docs/api)
# API_DOCS_ENABLED : interrupteur principal (false = 403 partout)
# API_DOCS_TOKEN   : requis hors local, à passer en ?token=
API_DOCS_ENABLED=true
API_DOCS_TOKEN=
API_VERSION=1.0.0

# Fournisseur OTP (SMS / WhatsApp) — `log` journalise au lieu d'envoyer
SMS_DRIVER=log
SMS_BASE_URL=
SMS_API_KEY=
SMS_SENDER_ID=WiGO
SMS_WHATSAPP_BASE_URL=
SMS_WHATSAPP_API_KEY=

# Push mobile (FCM) — `log` journalise au lieu d'envoyer
FCM_DRIVER=log
FCM_PROJECT_ID=
FCM_ACCESS_TOKEN=

# Wave Checkout — `fake` n'émet aucun appel réseau. Les clés des deux
# comptes (boutique, recharge) se saisissent dans « Paramètres ».
WAVE_DRIVER=fake

# Yango Fleet (solde, courses) n'a pas de pilote : l'API réelle est toujours
# appelée. Les identifiants (URL, park, clé) se saisissent dans
# « Paramètres » (YangoSettings, en base), pas ici.

# Plafonds de recharge, en FCFA entiers (cf. config/wigo.php)
WIGO_RECHARGE_MIN=500
WIGO_RECHARGE_MAX=100000
WIGO_RECHARGE_DAILY_CAP=150000
